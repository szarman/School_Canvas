# Copy this file to ".env" and fill it in. .env is gitignored -- never commit it.

# Your Canvas instance, no trailing slash.
CANVAS_BASE_URL=https://sdhc.instructure.com

# --- Preferred: a personal access token ---------------------------------
# Canvas -> Account -> Settings -> "+ New Access Token".
# If that button is missing, the district disabled student tokens; leave
# this blank and fill in the browser-login section instead.
CANVAS_TOKEN=

# The token's expiry date, YYYY-MM-DD. Canvas shows it when you create the
# token. The board displays a countdown in the final 30 days and a red warning
# once it lapses. Leave blank if the token never expires.
CANVAS_TOKEN_EXPIRES=

# --- Parent / observer accounts ------------------------------------------
# Only needed when the account observes more than one student. A single
# observed student is detected automatically, and scrape.py lists the IDs if
# it needs you to choose.
CANVAS_STUDENT_ID=

# --- Fallback: browser login --------------------------------------------
# Only used when CANVAS_TOKEN is blank or rejected.
CANVAS_USERNAME=
CANVAS_PASSWORD=

# --- Optional filtering --------------------------------------------------
# Comma-separated, case-insensitive substrings matched against the raw Canvas
# course name. INCLUDE wins if both are set.
#
# Districts enroll students in shells that are not classes -- info pages,
# homerooms, athletics, the media center. They carry no assignments and often
# embed the school name, a teacher surname or a room number, so they are worth
# excluding. A realistic starting point:
#   EXCLUDE_COURSES=info page,homeroom,hr:,athletics,media cent,incoming
INCLUDE_COURSES=
EXCLUDE_COURSES=

# How many days of already-graded work to keep on the board.
GRADED_HISTORY_DAYS=45

# Include a click-through link to each assignment in Canvas.
# Set to 0 to omit course/assignment IDs from the published data entirely.
INCLUDE_LINKS=1

# --- Cross-device sync (optional) ----------------------------------------
# The Cloudflare Worker URL from worker/README.md. Published in data.json so
# the board knows where to sync; not a secret, because the worker also demands
# a bearer key that is never published. Leave blank to keep marks per-device.
SYNC_URL=
